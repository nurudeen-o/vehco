{
  "name": "facotransport",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "prisma:seed:turso": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed-turso.ts",
    "setup:turso": "bash scripts/setup-turso.sh",
    "deploy": "bash scripts/deploy.sh",
    "electron:dev": "concurrently -k \"next dev --webpack -p 3142\" \"wait-on tcp:3142 && cross-env ELECTRON_START_URL=http://localhost:3142 electron .\"",
    "electron:start": "cross-env ELECTRON_START_URL=http://localhost:3142 electron .",
    "electron:build": "next build --webpack && node -e \"const fs=require('fs'); fs.rmSync('.next/cache',{recursive:true,force:true}); fs.rmSync('.next/dev',{recursive:true,force:true});\" && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "electron:build:mac": "next build --webpack && node -e \"const fs=require('fs'); fs.rmSync('.next/cache',{recursive:true,force:true}); fs.rmSync('.next/dev',{recursive:true,force:true});\" && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "electron:build:win": "next build --webpack && node -e \"const fs=require('fs'); fs.rmSync('.next/cache',{recursive:true,force:true}); fs.rmSync('.next/dev',{recursive:true,force:true});\" && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "electron:build:all": "next build --webpack && node -e \"const fs=require('fs'); fs.rmSync('.next/cache',{recursive:true,force:true}); fs.rmSync('.next/dev',{recursive:true,force:true});\" && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --win",
    "sync:full": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/run-sync.ts",
    "build:mobile": "node scripts/build-mobile.mjs",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "run:ios": "npm run cap:sync && npx cap run ios",
    "build:android": "cd android && ./gradlew assembleDebug",
    "build:ios": "xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "archive:ios": "xcodebuild archive -workspace ios/App/App.xcworkspace -scheme App -configuration Release -archivePath build/ios/App.xcarchive CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=\"\""
  },
  "build": {
    "appId": "com.facotransport.faco",
    "productName": "Faco Fleet",
    "asar": false,
    "compression": "maximum",
    "afterPack": "electron/after-pack.js",
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "icon": "public/logo.png",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "win": {
      "icon": "public/logo.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Faco Fleet"
    },
    "linux": {
      "icon": "public/logo.png"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "!**/.next/cache/**",
      "!**/.next/dev/**",
      "!**/.next/types/**",
      "!**/.next/diagnostics/**",
      "public/**/*",
      "prisma/**/*",
      "!prisma/seed.ts",
      "node_modules/**/*",
      "node_modules/.prisma/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.md",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/test/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/electron-winstaller/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/caniuse-lite/**",
      "!node_modules/prisma/**",
      "!node_modules/@prisma/engines/schema-engine*/**",
      "!node_modules/@prisma/engines/schema-engine*",
      "!node_modules/@prisma/client/runtime/*cockroachdb*",
      "!node_modules/@prisma/client/runtime/*mysql*",
      "!node_modules/@prisma/client/runtime/*postgresql*",
      "!node_modules/@prisma/client/runtime/*sqlserver*",
      "!node_modules/@types/**",
      "!node_modules/typescript/**",
      "!node_modules/tailwindcss/**",
      "!node_modules/postcss/**",
      "!node_modules/autoprefixer/**",
      "!node_modules/ts-node/**",
      "!node_modules/concurrently/**",
      "!node_modules/wait-on/**",
      "!node_modules/cross-env/**"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.460.0",
    "next": "^16.2.11",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "wait-on": "^9.5.1"
  }
}
